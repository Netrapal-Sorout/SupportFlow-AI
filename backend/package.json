{
  "name": "supportflow-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for SupportFlow AI",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
