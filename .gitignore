@"
# Dependencies
node_modules/

# Environment variables
.env
.env.*.local
!.env.example

# Build output
dist/
build/

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Vite
frontend/.vite/

# Playwright
frontend/playwright-report/
frontend/test-results/

# Backend temporary files
backend/tmp/
backend/uploads/
"@ | Set-Content -Path ".gitignore"