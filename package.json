{
  "name": "supportflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SupportFlow AI - customer support and operations platform",
  "scripts": {
    "install:all": "npm --prefix backend ci && npm --prefix frontend ci",
    "dev:backend": "npm --prefix backend run dev",
